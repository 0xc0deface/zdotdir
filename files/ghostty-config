theme = MattsTilixTheme
font-family = MesloLGM Nerd Font
font-size = 9
bell-features = system,attention,title
keybind = ctrl+page_up=unbind
keybind = ctrl+page_down=unbind
# freed for herdr tab cycling (herdr has no page_up/page_down token)
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind
keybind = ctrl+insert=copy_to_clipboard
keybind = shift+insert=paste_from_clipboard
keybind = shift+delete=copy_to_clipboard
